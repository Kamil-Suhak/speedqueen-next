{
  "name": "speedqueen-next",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:preview": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv",
    "report:preview": "npx tsx tools/reporter/index.ts",
    "report:send": "npx tsx tools/reporter/index.ts --send"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.609.0",
    "@neondatabase/serverless": "^1.0.2",
    "@react-email/render": "^2.0.4",
    "dotenv": "^17.3.1",
    "framer-motion": "^12.23.26",
    "lucide-react": "^0.562.0",
    "next": "^16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-email": "^6.6.5",
    "resend": "^6.9.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "wrangler": "^4.105.0"
  },
  "overrides": {
    "@opennextjs/cloudflare": {
      "glob": "^12.0.0"
    }
  }
}
